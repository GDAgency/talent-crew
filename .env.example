# Public site: team members and customers sign in and sign up here.
CLIENT_HOSTS=app.example.com
# Office (administrators only) under a path of the public site: https://app.example.com/admin/
ADMIN_PATH=/admin
# Or on its own address instead of ADMIN_PATH (with both, this address redirects to the path).
# ADMIN_HOSTS=admin.example.com
# One-time code asked when creating the first administrator (on the office site).
SETUP_CODE=change-me
# "off" closes self sign-up; accounts are then created only by the office.
SIGNUPS=on
# Port on this server.
PORT_ON_HOST=3000
